{
  "name": "crm-huescaventura-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "next build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "pnpm run check:boundaries",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:postgres": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
