{
  "install": {
    "command": [
      "pnpm",
      "install",
      "--frozen-lockfile"
    ],
    "exit": 0
  },
  "typecheck": {
    "command": [
      "pnpm",
      "run",
      "typecheck"
    ],
    "exit": 0
  },
  "lint": {
    "command": [
      "pnpm",
      "run",
      "lint"
    ],
    "exit": 0
  },
  "boundaries": {
    "command": [
      "pnpm",
      "run",
      "check:boundaries"
    ],
    "exit": 0
  },
  "unit": {
    "command": [
      "pnpm",
      "test"
    ],
    "exit": 0
  },
  "build": {
    "command": [
      "pnpm",
      "run",
      "build"
    ],
    "exit": 0
  },
  "audit": {
    "command": [
      "pnpm",
      "audit",
      "--prod"
    ],
    "exit": 0
  }
}
