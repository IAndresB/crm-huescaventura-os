  "source": "import assert from 'node:assert/strict';\nimport {mkdtemp,mkdir,readFile,writeFile,rm,symlink,copyFile,readdir} from 'node:fs/promises';\nimport {tmpdir} from 'node:os';\nimport {join,dirname} from 'node:path';\nimport {spawnSync} from 'node:child_process';\nimport {createHash} from 'node:crypto';\nimport {gzipSync,gunzipSync} from 'node:zlib';\nconst root=process.cwd(),out=join(root,'tests/fixtures/h5-009/f06'),script='scripts/verify-h5-008-evidence.mjs',hash=b=>createHash('sha256').update(b).digest('hex');\nconst git=(...args)=>{const r=spawnSync('git',args,{cwd:root,maxBuffer:256*1024*1024});assert.equal(r.status,0);return r.stdout;};\nconst sha=git('rev-parse','HEAD').toString().trim(),temp=await mkdtemp(join(tmpdir(),'crm-h5009-f06-')),runs=[];\nconst capture=async(name,cmd,args,expected)=>{const r=spawnSync(cmd,args,{cwd:temp,encoding:'utf8',maxBuffer:16*1024*1024,timeout:240000});const raw=Buffer.from(r.stdout+r.stderr);runs.push({name,sha,command:[cmd,...args],exit:r.status,expectedExit:expected,bytes:raw.length,sha256:hash(raw),logGzipBase64:gzipSync(raw).toString('base64')});assert.equal(r.status,expected,name+': '+raw.toString().slice(0,1800));console.log(name+(expected?' FAIL expected':' PASS'));};\ntry{\n const archive=git('archive','HEAD');assert.equal(spawnSync('tar',['-x','-C',temp],{input:archive}).status,0);\n await symlink(join(root,'.git'),join(temp,'.git'));await mkdir(join(temp,'node_modules'));for(const n of await readdir(join(root,'node_modules')))await symlink(join(root,'node_modules',n),join(temp,'node_modules',n));\n const local=git('ls-files','--modified','--others','--exclude-standard','-z').toString().split('\\0').filter(Boolean);\n for(const p of local){await mkdir(dirname(join(temp,p)),{recursive:true});await copyFile(join(root,p),join(temp,p));}\n await capture('lossless-four-originals',process.execPath,[script],0);\n const manifest='tests/fixtures/h5-009/f06/compression.json',original=await readFile(join(temp,manifest)),data=JSON.parse(original),path=data.items[0].compressedPath,packed=await readFile(join(temp,path));\n const modify=async(name,p,b)=>{const before=await readFile(join(temp,p));await writeFile(join(temp,p),b);try{await capture(name,process.execPath,[script],1);}finally{await writeFile(join(temp,p),before);}};\n await modify('corrupt-gzip-rejected',path,Buffer.from('not a gzip stream'));\n const falseHash=structuredClone(data);falseHash.items[0].sha256='0'.repeat(64);await modify('changed-original-hash-rejected',manifest,Buffer.from(JSON.stringify(falseHash)));\n const changed=gzipSync(Buffer.concat([gunzipSync(packed),Buffer.from(' ')]));const forged=structuredClone(data);forged.items[0].compressedBytes=changed.length;forged.items[0].compressedSha256=hash(changed);\n await writeFile(join(temp,path),changed);try{await modify('valid-gzip-with-altered-original-rejected',manifest,Buffer.from(JSON.stringify(forged)));}finally{await writeFile(join(temp,path),packed);}\n await rm(join(temp,path));try{await capture('missing-gzip-rejected',process.execPath,[script],1);}finally{await writeFile(join(temp,path),packed);}\n const dropped=structuredClone(data);dropped.items.pop();await modify('missing-evidence-entry-rejected',manifest,Buffer.from(JSON.stringify(dropped)));\n await capture('F05-18-counterproofs',process.execPath,['tests/fixtures/h5-009/f05-counterexamples.mjs'],0);\n const t=spawnSync('tar',['-czf',join(out,'f05-retest.tar.gz'),'-C',temp,'tests/fixtures/h5-009/f05']);assert.equal(t.status,0);\n await capture('F10-F12-preservation',process.execPath,['--experimental-strip-types','tests/fixtures/h5-006/f12/chain-counterexamples.mjs'],0);\n await writeFile(join(out,'counterproofs.json'),JSON.stringify({status:'PASS',testedSha:sha,originalVerificationSha:'0dae8a4a0b5ce92845b13fd82c60c1ed931184dc',f05RetestSha256:hash(await readFile(join(out,'f05-retest.tar.gz'))),source:await readFile(import.meta.filename,'utf8'),runs},null,2)+'\\n');\n}finally{await rm(temp,{recursive:true,force:true});}\n",
