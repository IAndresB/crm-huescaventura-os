  "contract": {
    "mechanism": "postgres17-custom-archive-create",
    "global_scope": "globals-only-no-role-passwords",
    "global_policy": "new-exclusive-cluster-default-tablespaces-only",
    "name_policy": "source-equals-archive-equals-destination",
    "maintenance_policy": "rename-only-empty-initdb-postgres-before-import",
    "maintenance_name_pattern": "^h6015_maint_[a-z0-9_]{1,40}$",
    "archive_target_must_not_exist": true,
    "create_transaction": "none-exit-on-error-discard-failed-destination",
    "owner_acl_settings": "archive-defaults-no-suppression",
    "property_snapshot_sql_sha256": "2d31aa842bf246642ffb36c7964e57c0b582972c85011a43d17a32177672fab5",
    "equivalence_fields": [
      "database",
      "owner",
      "acl-grantor-grantee-privilege-grant-option",
      "database-settings",
      "role-in-database-settings"
    ],
    "core_public_connect_temp": "source-and-destination-denied",
    "post_restore_gate": "private-exact-snapshot-equality-and-independent-effective-privilege-review",
    "runtime_evidence": "NO EJECUTADA; required in authorized H6-015",
    "resume_on_exit_zero": false
  },
  "commands": {
    "capture-globals": [
      "$H6015_BIN/pg_dumpall",
      "--host=$H6015_SOURCE_SOCKET",
      "--port=$H6015_SOURCE_PORT",
      "--username=$H6015_SOURCE_BOOTSTRAP",
      "--no-password",
      "--globals-only",
      "--no-role-passwords",
      "--file=$H6015_PRIVATE_DIR/globals.sql",
      ">/dev/null",
      "2>&1"
    ],
    "capture-database": [
      "$H6015_BIN/pg_dump",
      "--host=$H6015_SOURCE_SOCKET",
      "--port=$H6015_SOURCE_PORT",
      "--username=$H6015_SOURCE_BOOTSTRAP",
      "--no-password",
      "--dbname=$H6015_SOURCE_DB",
      "--format=custom",
      "--no-publications",
      "--no-subscriptions",
      "--file=$H6015_PRIVATE_DIR/database.dump",
      ">/dev/null",
      "2>&1"
    ],
    "source-properties": [
      "$H6015_BIN/psql",
      "-X",
      "--host=$H6015_SOURCE_SOCKET",
      "--port=$H6015_SOURCE_PORT",
      "--username=$H6015_SOURCE_BOOTSTRAP",
      "--no-password",
      "--dbname=$H6015_SOURCE_DB",
      "--set=ON_ERROR_STOP=1",
      "--tuples-only",
      "--no-align",
      "--file=$H6015_PRIVATE_DIR/database-properties.sql",
      ">$H6015_PRIVATE_DIR/source-properties.json",
      "2>/dev/null"
    ],
    "init-cluster": [
      "$H6015_BIN/initdb",
      "--pgdata=$H6015_DEST_DATA",
      "--username=$H6015_DEST_BOOTSTRAP",
      "--auth=trust",
      "--encoding=$H6015_ENCODING",
      "--locale-provider=libc",
      "--lc-collate=$H6015_LC_COLLATE",
      "--lc-ctype=$H6015_LC_CTYPE",
      ">/dev/null",
      "2>&1"
    ],
    "start-cluster": [
      "$H6015_BIN/pg_ctl",
      "-D",
      "$H6015_DEST_DATA",
      "-l",
      "/dev/null",
      "-o",
      "-k '$H6015_DEST_SOCKET' -h '' -p $H6015_DEST_PORT",
      "-w",
      "start",
      ">/dev/null",
      "2>&1"
    ],
    "reserve-maintenance": [
      "$H6015_BIN/psql",
      "-X",
      "--host=$H6015_DEST_SOCKET",
      "--port=$H6015_DEST_PORT",
      "--username=$H6015_DEST_BOOTSTRAP",
      "--no-password",
      "--dbname=template1",
      "--set=ON_ERROR_STOP=1",
      "--command=ALTER DATABASE postgres RENAME TO $H6015_MAINT_DB",
      ">/dev/null",
      "2>&1"
    ],
    "restore-globals": [
      "$H6015_BIN/psql",
      "-X",
      "--host=$H6015_DEST_SOCKET",
      "--port=$H6015_DEST_PORT",
      "--username=$H6015_DEST_BOOTSTRAP",
      "--no-password",
      "--dbname=$H6015_MAINT_DB",
      "--set=ON_ERROR_STOP=1",
      "--single-transaction",
      "--file=$H6015_PRIVATE_DIR/globals.sql",
      ">/dev/null",
      "2>&1"
    ],
    "restore-database": [
      "$H6015_BIN/pg_restore",
      "--host=$H6015_DEST_SOCKET",
      "--port=$H6015_DEST_PORT",
      "--username=$H6015_DEST_BOOTSTRAP",
      "--no-password",
      "--dbname=$H6015_MAINT_DB",
      "--create",
      "--exit-on-error",
      "$H6015_PRIVATE_DIR/database.dump",
      ">/dev/null",
      "2>&1"
    ],
    "destination-properties": [
      "$H6015_BIN/psql",
      "-X",
      "--host=$H6015_DEST_SOCKET",
      "--port=$H6015_DEST_PORT",
      "--username=$H6015_DEST_BOOTSTRAP",
      "--no-password",
      "--dbname=$H6015_DEST_DB",
      "--set=ON_ERROR_STOP=1",
      "--tuples-only",
      "--no-align",
      "--file=$H6015_PRIVATE_DIR/database-properties.sql",
      ">$H6015_PRIVATE_DIR/destination-properties.json",
      "2>/dev/null"
    ],
    "compare-properties": [
      "/usr/bin/cmp",
      "-s",
      "$H6015_PRIVATE_DIR/source-properties.json",
      "$H6015_PRIVATE_DIR/destination-properties.json"
    ]
  },
  "command_order": [
    "capture-globals",
    "capture-database",
    "source-properties",
    "init-cluster",
    "start-cluster",
    "reserve-maintenance",
    "restore-globals",
    "restore-database",
    "destination-properties",
    "compare-properties"
  ],
  "snapshot_sql": "WITH db AS (\n  SELECT oid, datname, datdba, datacl FROM pg_database\n  WHERE datname = current_database()\n), acl_rows AS (\n  SELECT jsonb_build_array(pg_get_userbyid(a.grantor),\n    CASE WHEN a.grantee = 0 THEN NULL ELSE pg_get_userbyid(a.grantee) END,\n    a.privilege_type, a.is_grantable) AS item\n  FROM db CROSS JOIN LATERAL\n    aclexplode(COALESCE(db.datacl, acldefault('d', db.datdba))) AS a\n), settings_rows AS (\n  SELECT jsonb_build_array(\n    CASE WHEN s.setrole = 0 THEN NULL ELSE pg_get_userbyid(s.setrole) END,\n    setting) AS item\n  FROM db JOIN pg_db_role_setting AS s ON s.setdatabase = db.oid\n  CROSS JOIN LATERAL unnest(s.setconfig) AS setting\n)\nSELECT jsonb_build_object(\n  'database', db.datname,\n  'owner', pg_get_userbyid(db.datdba),\n  'acl', COALESCE((SELECT jsonb_agg(item ORDER BY item::text COLLATE \"C\") FROM acl_rows), '[]'::jsonb),\n  'settings', COALESCE((SELECT jsonb_agg(item ORDER BY item::text COLLATE \"C\") FROM settings_rows), '[]'::jsonb)\n) FROM db;\n",
